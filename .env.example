# ==========================================
# MediKiosk Environment Variables Template
# ==========================================
# Copy this file and fill in values.
# NEVER commit actual secrets to git.
#
# apps/kiosk/.env.local
# apps/doctor/.env.local
# apps/admin/.env.local
# services/api/.env
# services/ai-history/.env
# services/ai-documents/.env

# ------------------------------------------
# Supabase (https://supabase.com)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------
# Express API
# ------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
NODE_ENV=development

# JWT (if using custom JWTs beyond Supabase)
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS

# ------------------------------------------
# AI Services
# ------------------------------------------
AI_HISTORY_URL=http://localhost:8001
AI_DOCUMENTS_URL=http://localhost:8002

# ------------------------------------------
# LLM — Google Gemini
# ------------------------------------------
GOOGLE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-2.0-flash
LLM_FALLBACK_MODEL=gemini-1.5-pro

# ------------------------------------------
# ASR — Bhashini API (Indian languages)
# https://bhashini.gov.in/
# ------------------------------------------
BHASHINI_API_KEY=YOUR_BHASHINI_API_KEY
BHASHINI_USER_ID=YOUR_BHASHINI_USER_ID
BHASHINI_PIPELINE_ID=YOUR_BHASHINI_PIPELINE_ID
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# Fallback: OpenAI Whisper (for English)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ------------------------------------------
# Supabase Storage Buckets
# ------------------------------------------
SUPABASE_MEDICAL_DOCS_BUCKET=medical-documents
SUPABASE_AUDIO_RECORDINGS_BUCKET=audio-recordings
SUPABASE_PROCESSED_DOCS_BUCKET=processed-documents

# ------------------------------------------
# Observability
# ------------------------------------------
# Sentry (application monitoring)
SENTRY_DSN=YOUR_SENTRY_DSN

# Langfuse (AI/LLM observability)
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------
# ABDM (Ayushman Bharat Digital Mission)
# ------------------------------------------
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=YOUR_ABDM_CLIENT_ID
ABDM_CLIENT_SECRET=YOUR_ABDM_CLIENT_SECRET

# ------------------------------------------
# HIS Integration (Mock during development)
# ------------------------------------------
HIS_BASE_URL=http://localhost:9000
HIS_MOCK_ENABLED=true

# ------------------------------------------
# App URLs (for CORS, redirects)
# ------------------------------------------
KIOSK_URL=http://localhost:3000
DOCTOR_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
